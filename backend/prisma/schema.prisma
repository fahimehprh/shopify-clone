generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BasketStatus {
  PENDING
  EXPIRED
  CHECKED_OUT
}

model User {
  id        String   @id @default(uuid())
  name      String
  baskets   Basket[]
}

model Product {
  id          String      @id @default(uuid())
  name        String
  stock       Int         @default(0)
  basketItems BasketItem[]
}

model Basket {
  id String  @id @default(uuid())
  user User @relation(fields: [userId], references: [id])
  userId String
  status BasketStatus
  items BasketItem[]
  createdAt DateTime @default(now())
}


model BasketItem {
  id        String  @id @default(uuid())
  basket     Basket   @relation(fields: [basketId], references: [id])
  basketId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
}
